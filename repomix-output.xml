              {theme.currentUser.shortName}
            </Typography>
            <Typography
              sx={{
                fontSize: "0.55rem",
                color: "#78827b",
                mt: 0.3,
                overflow: "hidden",
                textOverflow: "ellipsis",
                whiteSpace: "nowrap",
