<file path="src/pages/DocumentsPage.jsx">
import React, { useMemo, useRef, useState } from "react";
import {
  Box,
  Typography,
  Stack,
  TextField,
  InputAdornment,
  Dialog,
  DialogTitle,
  DialogContent,
  IconButton,
} from "@mui/material";
import {
  Download as ArrowDownToLine,
  Description as FileText,
  Search,
  UploadFile,
  Close,
  Delete,
} from "@mui/icons-material";
import { documents as seedDocuments } from "../data/peopleHubData.js";
import { Badge, Button, EmptyState, PageHeader } from "../components/PortalUI.jsx";

function downloadFile(name, content) {
  const url = URL.createObjectURL(new Blob([content], { type: "text/plain" }));
  const link = document.createElement("a");
  link.href = url;
  link.download = name;
  link.click();
  URL.revokeObjectURL(url);
}

export default function DocumentsPage({ uploadedDocuments = [], onUpload, onDelete }) {
  const [category, setCategory] = useState("All documents");
  const [query, setQuery] = useState("");
  const [preview, setPreview] = useState(null);
  const fileInput = useRef(null);
  const documents = [
    ...seedDocuments,
    ...uploadedDocuments.map((document) => ({
      ...document,
      category: "My uploads",
      updated: `Uploaded ${document.uploaded}`,
      uploaded: true,
    })),
  ];

  const categories = [
    "All documents",
    ...new Set(documents.map((d) => d.category)),
  ];

  const filtered = useMemo(
    () =>
      documents.filter(
        (document) =>
          (category === "All documents" || document.category === category) &&
          `${document.name} ${document.category}`
            .toLowerCase()
            .includes(query.toLowerCase())
      ),
    [category, query, uploadedDocuments]
  );

  const colorPalette = [
    { bg: "#eaf2ec", color: "#517c5d" },
    { bg: "#fcf0e8", color: "#bd7952" },
    { bg: "#eaf1f7", color: "#5b829f" },
    { bg: "#f5edef", color: "#a76e73" },
  ];

  return (
    <>
      <PageHeader
        eyebrow="YOUR REFERENCE LIBRARY"
        title="Documents"
        description="Company policies, benefits and useful forms in one place."
        action={
          <>
            <input
              ref={fileInput}
              type="file"
              multiple
              hidden
              onChange={(event) => {
                if (event.target.files?.length) onUpload(Array.from(event.target.files));
                event.target.value = "";
              }}
            />
            <Button icon={UploadFile} onClick={() => fileInput.current?.click()}>
              Upload documents
            </Button>
          </>
        }
      />

      <Stack
        direction={{ xs: "column", md: "row" }}
        justifyContent="space-between"
        alignItems={{ xs: "stretch", md: "center" }}
        spacing={1.5}
        sx={{ mb: 1.8, mt: 0.7 }}
      >
        <TextField
          placeholder="Find a document..."
          value={query}
          onChange={(e) => setQuery(e.target.value)}
          size="small"
          sx={{
            width: { xs: "100%", md: 250 },
            "& .MuiOutlinedInput-root": {
              fontSize: "0.65rem",
              borderRadius: 1,
              background: "#fff",
              "& fieldset": { borderColor: "#e5eae5" },
              "&:hover fieldset": { borderColor: "#9eb9a7" },
              "&.Mui-focused fieldset": { borderColor: "#9eb9a7" },
            },
          }}
          slotProps={{
            input: {
              startAdornment: (
                <InputAdornment position="start">
                  <Search sx={{ fontSize: 16, color: "#8d9890" }} />
                </InputAdornment>
              ),
            },
          }}
        />

        <Stack
          direction="row"
          spacing={0.4}
          sx={{
            p: 0.4,
            border: "1px solid #e5eae5",
            borderRadius: 1,
            background: "#fff",
            overflowX: "auto",
            justifyContent: { xs: "flex-start", md: "center" },
          }}
        >
          {categories.map((item) => {
            const active = category === item;
            return (
              <Box
                key={item}
                onClick={() => setCategory(item)}
                sx={{
                  flexShrink: 0,
                  px: 1.2,
                  py: 0.7,
                  borderRadius: 0.6,
                  background: active ? "#eaf2ec" : "transparent",
                  color: active ? "#39644a" : "#7e8981",
                  fontSize: "0.6rem",
                  fontWeight: active ? 700 : 500,
                  cursor: "pointer",
                  "&:hover": { color: "primary.main" },
                  transition: "background 0.15s",
                }}
              >
                {item}
              </Box>
            );
          })}
        </Stack>
      </Stack>

      <Box
        sx={{
          display: "grid",
          gridTemplateColumns: {
            xs: "1fr",
            sm: "repeat(2, minmax(0, 1fr))",
            md: "repeat(3, minmax(0, 1fr))",
          },
          gap: 1.5,
        }}
      >
        {filtered.map((document, index) => {
          const tone = colorPalette[index % 4];
          return (
            <Box
              key={document.id || document.name}
              sx={{
                display: "flex",
                flexDirection: "column",
                minHeight: 194,
                p: 2,
                border: "1px solid #e6ebe5",
                borderRadius: 1,
                background: "#fff",
                boxShadow: "0 1px 2px rgba(30,46,34,0.02)",
                transition: "border-color 0.16s, transform 0.16s",
                "&:hover": {
                  transform: "translateY(-2px)",
                  borderColor: "#cfdbd0",
                },
              }}
            >
              <Box
                sx={{
                  width: 34,
                  height: 34,
                  mb: 1.6,
                  borderRadius: 1,
                  background: tone.bg,
                  color: tone.color,
                  display: "grid",
                  placeItems: "center",
                }}
              >
                <FileText sx={{ fontSize: 19 }} />
              </Box>
              <Box>
                <Badge>{document.category}</Badge>
              </Box>
              <Typography
                sx={{
                  mt: 1.1,
                  mb: 0.6,
                  fontFamily: "Manrope",
                  fontWeight: 700,
                  fontSize: "0.75rem",
                  color: "#354139",
                }}
              >
                {document.name}
              </Typography>
              <Typography
                sx={{
                  flex: 1,
                  color: "#818c84",
                  fontSize: "0.6rem",
                  lineHeight: 1.6,
                }}
              >
                  {document.description || "Uploaded by you."}
              </Typography>

              <Stack
                direction="row"
                justifyContent="space-between"
                alignItems="center"
                spacing={1}
                sx={{
                  mt: 1.7,
                  pt: 1.2,
                  borderTop: "1px solid #eff1ee",
                  color: "#9aa39b",
                  fontSize: "0.55rem",
                }}
              >
                <span>{document.updated}</span>
                <Box
                  component="button"
                  onClick={() => document.uploaded ? setPreview(document) : downloadFile(
                    `${document.name.toLowerCase().replaceAll(" ", "-")}.txt`,
                    `${document.name}\n\n${document.description}\n\nSample PeopleHub document.`
                  )}
                  sx={{
                    display: "inline-flex",
                    alignItems: "center",
                    gap: 0.5,
                    p: 0,
                    border: 0,
                    background: "transparent",
                    color: "#52755a",
                    fontSize: "0.6rem",
                    fontWeight: 600,
                    cursor: "pointer",
                  }}
                >
                  <ArrowDownToLine sx={{ fontSize: 15 }} /> {document.uploaded ? "Open" : "Download"}
                </Box>
                {document.uploaded && (
                  <IconButton aria-label={`Remove ${document.name}`} onClick={() => onDelete(document.id)} size="small" sx={{ color: "#8d9890" }}>
                    <Delete sx={{ fontSize: 15 }} />
                  </IconButton>
                )}
              </Stack>
            </Box>
          );
        })}
      </Box>

      <Dialog open={Boolean(preview)} onClose={() => setPreview(null)} fullWidth maxWidth="md">
        <DialogTitle sx={{ display: "flex", justifyContent: "space-between", alignItems: "center", fontFamily: "Manrope", fontSize: "0.9rem", fontWeight: 700 }}>
          {preview?.name}
          <IconButton aria-label="Close document preview" onClick={() => setPreview(null)} size="small"><Close fontSize="small" /></IconButton>
        </DialogTitle>
        <DialogContent dividers sx={{ minHeight: 240, display: "grid", placeItems: "center" }}>
          {preview?.type?.startsWith("image/") ? (
            <Box component="img" src={preview.data} alt={preview.name} sx={{ maxWidth: "100%", maxHeight: "65vh", objectFit: "contain" }} />
          ) : preview?.type === "application/pdf" ? (
            <Box component="iframe" title={preview.name} src={preview.data} sx={{ width: "100%", height: "65vh", border: 0 }} />
          ) : (
            <Stack alignItems="center" spacing={1.2}>
              <FileText sx={{ fontSize: 34, color: "#66806a" }} />
              <Typography sx={{ color: "#78837b", fontSize: "0.7rem" }}>Preview is not available for this file type.</Typography>
              <Box component="a" href={preview?.data} download={preview?.name} sx={{ color: "#416b4d", fontSize: "0.7rem", fontWeight: 700 }}>Download file</Box>
            </Stack>
          )}
        </DialogContent>
      </Dialog>

      {filtered.length === 0 && (
        <EmptyState
          title="No documents found"
          description="Try another search or category."
        />
      )}
    </>
  );
}
</file>

<file path="src/pages/PayPage.jsx">
import React, { useMemo, useState } from "react";
import {
  Box,
  Typography,
  Stack,
  TextField,
  MenuItem,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
} from "@mui/material";
import {
  Download as ArrowDownToLine,
  CalendarMonth as CalendarDays,
  Download,
  AccountBalanceWallet as WalletCards,
} from "@mui/icons-material";
import { payslips } from "../data/peopleHubData.js";
import { theme } from "../theme.js";
import {
  Badge,
  Button,
  PageHeader,
  Panel,
  StatCard,
} from "../components/PortalUI.jsx";

function money(value) {
  return new Intl.NumberFormat("en-IN", {
    style: "currency",
    currency: "INR",
    maximumFractionDigits: 0,
  }).format(value);
}

export default function PayPage() {
  const [year, setYear] = useState("2026");
  const rows = useMemo(
    () => payslips.filter((slip) => slip.month.endsWith(year)),
    [year]
  );

  function download(selected = rows) {
    const content = [
      ["Month", "Gross", "Deductions", "Net", "Status"],
      ...selected.map((row) => [
        row.month,
        row.gross,
        row.deductions,
        row.net,
        row.status,
      ]),
    ]
      .map((row) => row.join(","))
      .join("\n");
    const url = URL.createObjectURL(new Blob([content], { type: "text/csv" }));
    const link = document.createElement("a");
    link.href = url;
    link.download =
      selected.length === 1
        ? `payslip-${selected[0].month.toLowerCase().replaceAll(" ", "-")}.csv`
        : `payslips-${year}.csv`;
    link.click();
    URL.revokeObjectURL(url);
  }

  return (
    <>
      <PageHeader
        eyebrow="COMPENSATION"
        title="Pay"
        description="A clear view of your salary and recent pay statements."
        action={
          <Button
            variant="secondary"
            icon={ArrowDownToLine}
            onClick={() => download()}
          >
            Download summary
          </Button>
        }
      />

      {/* ── Hero card ─────────────────────────────────── */}
      <Box
        sx={{
          position: "relative",
          display: "flex",
          alignItems: "center",
          gap: 2,
          minHeight: 107,
          overflow: "hidden",
          p: "18px 21px",
          mb: 1.8,
          border: "1px solid #2b5540",
          borderRadius: 1,
          background: "linear-gradient(108deg, #274f3c, #41654a)",
          color: "#fff",
        }}
      >
        <Box
          sx={{
            width: 40,
            height: 40,
            border: "1px solid rgba(255,255,255,0.19)",
            borderRadius: 1,
            background: "rgba(255,255,255,0.09)",
            color: "#dce9d5",
            display: "grid",
            placeItems: "center",
            flexShrink: 0,
          }}
        >
          <WalletCards sx={{ fontSize: 20 }} />
        </Box>
        <Box>
          <Typography
            sx={{
              fontSize: "0.55rem",
              fontWeight: 700,
              letterSpacing: "0.8px",
              color: "#ccdbcf",
            }}
          >
            LAST NET PAY · SEPTEMBER 2026
          </Typography>
          <Typography
            sx={{
              fontFamily: "Manrope",
              fontWeight: 700,
              fontSize: "1.5rem",
              mt: 0.5,
            }}
          >
            {money(52133)}
          </Typography>
          <Typography sx={{ fontSize: "0.6rem", color: "#cad8cd", mt: 0.5 }}>
            Deposited to your registered bank account on Sep 30
          </Typography>
        </Box>
        <Box sx={{ ml: "auto", zIndex: 1 }}>
          <Badge tone="light-green">Paid</Badge>
        </Box>
        {/* Decorative circles */}
        <Box
          sx={{
            position: "absolute",
            width: 90,
            height: 90,
            top: -44,
            right: 40,
            border: "1px solid rgba(255,255,255,0.09)",
            borderRadius: "50%",
            boxShadow: "0 0 0 18px rgba(255,255,255,0.03)",
          }}
        />
        <Box
          sx={{
            position: "absolute",
            width: 110,
            height: 110,
            right: 100,
            bottom: -71,
            border: "1px solid rgba(255,255,255,0.09)",
            borderRadius: "50%",
          }}
        />
      </Box>

      {/* ── Stats ─────────────────────────────────────── */}
      <Box
        sx={{
          display: "grid",
          gridTemplateColumns: { xs: "repeat(3, 1fr)", sm: "repeat(3, 1fr)" },
          gap: 1.5,
          mb: 2,
        }}
      >
        <StatCard
          label="Monthly gross"
          value={money(58333)}
          note="Base salary and allowances"
          icon={WalletCards}
          tone="green"
        />
        <StatCard
          label="Deductions"
          value={money(6200)}
          note="Tax and benefits"
          icon={ArrowDownToLine}
          tone="orange"
        />
        <StatCard
          label="Next payday"
          value="Oct 30"
          note="October 2026 payroll"
          icon={CalendarDays}
          tone="blue"
        />
      </Box>

      <Panel title="Employment details" subtitle="Your current employee record" sx={{ mb: 2 }}>
        <TableContainer sx={{ overflowX: "auto" }}>
          <Table sx={{ minWidth: 620 }}>
            <TableHead>
              <TableRow>
                <TableCell>EMPLOYEE ID</TableCell>
                <TableCell>DATE OF JOINING</TableCell>
                <TableCell>JOB TITLE</TableCell>
                <TableCell>DEPARTMENT</TableCell>
              </TableRow>
            </TableHead>
            <TableBody>
              <TableRow>
                <TableCell>{theme.currentUser.employeeId}</TableCell>
                <TableCell>Jun 12, 2025</TableCell>
                <TableCell>{theme.currentUser.role}</TableCell>
                <TableCell>{theme.currentUser.department}</TableCell>
              </TableRow>
            </TableBody>
          </Table>
        </TableContainer>
      </Panel>

      {/* ── Pay history table ─────────────────────────── */}
      <Panel
        title="Pay history"
        subtitle="Your recent pay statements"
        action={
          <TextField
            select
            size="small"
            value={year}
            onChange={(e) => setYear(e.target.value)}
            sx={{
              minWidth: 100,
              "& .MuiOutlinedInput-root": {
                fontSize: "0.65rem",
                borderRadius: 1,
                "& fieldset": { borderColor: "#e5eae5" },
              },
              "& .MuiInputBase-input": { py: 0.8, px: 1 },
            }}
          >
            <MenuItem value="2026" sx={{ fontSize: "0.65rem" }}>2026</MenuItem>
            <MenuItem value="2025" sx={{ fontSize: "0.65rem" }}>2025</MenuItem>
          </TextField>
        }
      >
        <TableContainer sx={{ overflowX: "auto" }}>
          <Table sx={{ minWidth: 720 }}>
            <TableHead>
              <TableRow>
                <TableCell>PAY PERIOD</TableCell>
                <TableCell>GROSS PAY</TableCell>
                <TableCell>DEDUCTIONS</TableCell>
                <TableCell>NET PAY</TableCell>
                <TableCell>STATUS</TableCell>
                <TableCell>STATEMENT</TableCell>
              </TableRow>
            </TableHead>
            <TableBody>
              {rows.map((row) => (
                <TableRow key={row.month} sx={{ "&:hover": { background: "#fcfdfb" } }}>
                  <TableCell>
                    <Typography
                      sx={{ fontSize: "0.65rem", fontWeight: 600, color: "#354138" }}
                    >
                      {row.month}
                    </Typography>
                  </TableCell>
                  <TableCell>{money(row.gross)}</TableCell>
                  <TableCell sx={{ color: "#8a948d" }}>
                    − {money(row.deductions)}
                  </TableCell>
                  <TableCell>
                    <Box
                      component="strong"
                      sx={{ color: "#355b41", fontSize: "0.65rem" }}
                    >
                      {money(row.net)}
                    </Box>
                  </TableCell>
                  <TableCell>
                    <Badge tone="green">{row.status}</Badge>
                  </TableCell>
                  <TableCell>
                    <Box
                      component="button"
                      onClick={() => download([row])}
                      aria-label={`Download ${row.month} statement`}
                      sx={{
                        width: 27,
                        height: 27,
                        border: "1px solid transparent",
                        borderRadius: 0.8,
                        background: "transparent",
                        color: "#96a097",
                        cursor: "pointer",
                        display: "grid",
                        placeItems: "center",
                        "&:hover": {
                          borderColor: "#e2e9e2",
                          background: "#f5f8f4",
                          color: "primary.main",
                        },
                      }}
                    >
                      <Download sx={{ fontSize: 15 }} />
                    </Box>
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>

          {rows.length === 0 && (
            <Box
              sx={{
                py: 3.5,
                px: 2,
                textAlign: "center",
                color: "#849087",
                fontSize: "0.65rem",
              }}
            >
              No statements found for {year}.
            </Box>
          )}
        </TableContainer>

        <Stack
          direction="row"
          justifyContent="space-between"
          alignItems="center"
          sx={{
            minHeight: 41,
            px: 2,
            borderTop: "1px solid #edf0ec",
            color: "#8d978f",
            fontSize: "0.6rem",
          }}
        >
          <span>Amounts shown in Indian rupees</span>
          <Box
            component="button"
            onClick={() =>
              window.dispatchEvent(new CustomEvent("open-support"))
            }
            sx={{
              display: "inline-flex",
              alignItems: "center",
              gap: 0.5,
              border: 0,
              background: "transparent",
              color: "#50745a",
              fontSize: "0.6rem",
              fontWeight: 600,
              cursor: "pointer",
            }}
          >
            Questions about your pay? <span>↗</span>
          </Box>
        </Stack>
      </Panel>
    </>
  );
}
</file>

<file path="src/pages/TimeOffPage.jsx">
import React, { useState } from "react";
import {
  Box,
  Typography,
  Stack,
  TextField,
  MenuItem,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  IconButton,
} from "@mui/material";
import {
  CalendarMonth as CalendarDays,
  Add as Plus,
  ChevronLeft,
  ChevronRight,
} from "@mui/icons-material";
import {
  Badge,
  Button,
  PageHeader,
  Panel,
} from "../components/PortalUI.jsx";

export default function TimeOffPage({ leaves, onAction, onCancel }) {
  const [filter, setFilter] = useState("All requests");
  const [month, setMonth] = useState(() => {
    const date = new Date();
    return new Date(date.getFullYear(), date.getMonth(), 1);
  });
  const [selectedDate, setSelectedDate] = useState(() => {
    const date = new Date();
    return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
  });
  const filtered = leaves.filter(
    (leave) => filter === "All requests" || leave.status === filter
  );
  const leaveTypes = [
    { name: "Casual leave", total: 12, tone: "#4f8060" },
    { name: "Sick leave", total: 10, tone: "#5481a0" },
    { name: "Annual leave", total: 18, tone: "#be7952" },
    { name: "Unpaid leave", total: 0, tone: "#9b6b76" },
  ];
  const usedDaysFor = (type) => leaves
    .filter((leave) => leave.type === type && leave.status === "Approved")
    .reduce((total, leave) => total + leave.days, 0);
  const totalRemaining = leaveTypes.reduce(
    (total, type) => total + Math.max(type.total - usedDaysFor(type.name), 0),
    0
  );
  const offset = (new Date(month.getFullYear(), month.getMonth(), 1).getDay() + 6) % 7;
  const dayCount = new Date(month.getFullYear(), month.getMonth() + 1, 0).getDate();
  const calendarDays = Array.from(
    { length: Math.ceil((offset + dayCount) / 7) * 7 },
    (_, index) => {
      const day = index - offset + 1;
      return day < 1 || day > dayCount
        ? null
        : `${month.getFullYear()}-${String(month.getMonth() + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
    }
  );
  const leavesByDate = leaves.filter((leave) => leave.status !== "Cancelled").reduce((days, leave) => {
    const start = new Date(`${leave.start} 12:00:00`);
    const end = new Date(`${leave.end} 12:00:00`);
    for (const date = new Date(start); date <= end; date.setDate(date.getDate() + 1)) {
      const key = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
      days[key] = [...(days[key] || []), leave];
    }
    return days;
  }, {});

  return (
    <>
      <PageHeader
        eyebrow="TIME AWAY"
        title="Request leave"
        description="Submit a leave request and keep track of its status."
        action={
          <Button icon={Plus} onClick={() => onAction("leave")}>
            Request leave
          </Button>
        }
      />

      {/* ── Balance banner ────────────────────────────── */}
      <Box
        sx={{
          display: "flex",
          flexDirection: { xs: "column", md: "row" },
          alignItems: { xs: "flex-start", md: "center" },
          justifyContent: "space-between",
          gap: { xs: 1.8, md: 2.5 },
          minHeight: 118,
          p: { xs: 2, md: "17px 20px" },
          mb: 2,
          border: "1px solid #dce8de",
          borderRadius: 1,
          background:
            "linear-gradient(110deg, #edf4ed, #f4f8f4 68%, #f8faf7)",
        }}
      >
        <Stack direction="row" alignItems="center" spacing={1.6}>
          <Box
            sx={{
              width: 40,
              height: 40,
              border: "1px solid #d8e6d9",
              borderRadius: 1,
              background: "#f9fcf8",
              color: "#4d795a",
              display: "grid",
              placeItems: "center",
              flexShrink: 0,
            }}
          >
            <CalendarDays sx={{ fontSize: 19 }} />
          </Box>
          <Box>
            <Typography
              sx={{
                fontSize: "0.55rem",
                fontWeight: 700,
                letterSpacing: "0.8px",
                color: "#819087",
              }}
            >
              YOUR BALANCE
            </Typography>
            <Typography
              sx={{
                fontFamily: "Manrope",
                fontWeight: 700,
                fontSize: "1.3rem",
                color: "#35563e",
                mt: 0.4,
              }}
            >
              {totalRemaining}{" "}
              <Box
                component="span"
                sx={{ fontSize: "0.65rem", fontWeight: 500, color: "#66806d" }}
              >
                days available
              </Box>
            </Typography>
            <Typography sx={{ fontSize: "0.6rem", color: "#839087", mt: 0.4 }}>
              Resets on January 1, 2027
            </Typography>
          </Box>
        </Stack>

        <Stack
          direction="row"
          spacing={2.5}
          sx={{ pl: { xs: 0, md: 0 }, width: { xs: "100%", md: "auto" } }}
        >
          {leaveTypes.slice(0, 2).map((type) => (
            <Box
              key={type.name}
              sx={{
                display: "grid",
                gridTemplateColumns: "8px auto",
                gap: "3px 6px",
                alignItems: "center",
                color: "#67756a",
                fontSize: "0.6rem",
              }}
            >
              <Box
                sx={{
                  gridRow: 1,
                  width: 7,
                  height: 7,
                  borderRadius: "50%",
                  background: type.tone,
                }}
              />
              <span>{type.name}</span>
              <Box
                component="strong"
                sx={{
                  gridColumn: 2,
                  color: "#34483a",
                  fontSize: "0.7rem",
                }}
              >
                {Math.max(type.total - usedDaysFor(type.name), 0)} days
              </Box>
            </Box>
          ))}
        </Stack>
      </Box>

      <Box sx={{ display: "grid", gridTemplateColumns: { xs: "repeat(2, minmax(0, 1fr))", md: "repeat(4, minmax(0, 1fr))" }, gap: 1.2, mb: 2 }}>
        {leaveTypes.map((type) => {
          const used = usedDaysFor(type.name);
          return (
            <Box key={type.name} component="button" onClick={() => onAction("leave", { type: type.name })} sx={{ p: 1.6, textAlign: "left", border: "1px solid #e5eae5", borderRadius: 1, background: "#fff", cursor: "pointer", "&:hover": { borderColor: type.tone } }}>
              <Typography sx={{ fontSize: "0.62rem", fontWeight: 700, color: "#455249" }}>{type.name}</Typography>
              <Typography sx={{ mt: 0.8, fontFamily: "Manrope", fontWeight: 700, fontSize: "1.05rem", color: type.tone }}>{Math.max(type.total - used, 0)} <Box component="span" sx={{ fontSize: "0.6rem", fontWeight: 500 }}>remaining</Box></Typography>
              <Typography sx={{ mt: 0.4, fontSize: "0.56rem", color: "#89948c" }}>{used} used of {type.total} days</Typography>
            </Box>
          );
        })}
      </Box>

      <Panel title="Leave calendar" subtitle="Select a day to see scheduled time away" sx={{ mb: 2 }}>
        <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", md: "minmax(280px, 0.85fr) 1fr" }, gap: 2, p: { xs: 1.4, sm: 2 } }}>
          <Box>
            <Stack direction="row" alignItems="center" justifyContent="space-between" sx={{ mb: 1.2 }}>
              <Typography sx={{ fontFamily: "Manrope", fontWeight: 700, fontSize: "0.8rem", color: "#344037" }}>{month.toLocaleDateString("en-US", { month: "long", year: "numeric" })}</Typography>
              <Stack direction="row">
                <IconButton aria-label="Previous month" size="small" onClick={() => setMonth(new Date(month.getFullYear(), month.getMonth() - 1, 1))}><ChevronLeft fontSize="small" /></IconButton>
                <IconButton aria-label="Next month" size="small" onClick={() => setMonth(new Date(month.getFullYear(), month.getMonth() + 1, 1))}><ChevronRight fontSize="small" /></IconButton>
              </Stack>
            </Stack>
            <Box sx={{ display: "grid", gridTemplateColumns: "repeat(7, minmax(0, 1fr))", gap: 0.4 }}>
              {["M", "T", "W", "T", "F", "S", "S"].map((day, index) => <Typography key={`${day}-${index}`} sx={{ py: 0.5, textAlign: "center", color: "#929c94", fontSize: "0.58rem", fontWeight: 700 }}>{day}</Typography>)}
              {calendarDays.map((date, index) => date ? (
                <Box key={date} component="button" aria-label={new Date(`${date}T12:00:00`).toLocaleDateString("en-US", { dateStyle: "full" })} onClick={() => setSelectedDate(date)} sx={{ position: "relative", display: "grid", placeItems: "center", aspectRatio: "1", border: 0, borderRadius: 0.8, background: selectedDate === date ? "#eaf2ec" : "transparent", color: selectedDate === date ? "#27614e" : "#4f5b52", fontSize: "0.62rem", fontWeight: selectedDate === date ? 700 : 500, cursor: "pointer", "&:hover": { background: "#f1f5f1" } }}>
                  {Number(date.slice(-2))}
                  {leavesByDate[date]?.length > 0 && <Box sx={{ position: "absolute", bottom: 3, width: 4, height: 4, borderRadius: "50%", background: leavesByDate[date][0].status === "Approved" ? "#54845f" : "#c98554" }} />}
                </Box>
              ) : <Box key={`empty-${index}`} />)}
            </Box>
          </Box>
          <Box sx={{ minHeight: 170, p: 1.6, border: "1px solid #edf0ec", borderRadius: 1, background: "#fbfcfa" }}>
            <Typography sx={{ fontSize: "0.62rem", fontWeight: 700, color: "#455249" }}>{new Date(`${selectedDate}T12:00:00`).toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric" })}</Typography>
            {(leavesByDate[selectedDate] || []).length ? leavesByDate[selectedDate].map((leave) => (
              <Box key={leave.id} onClick={() => onAction("leave-detail", leave)} sx={{ mt: 1, p: 1, borderLeft: `3px solid ${leave.status === "Approved" ? "#54845f" : "#c98554"}`, background: "#fff", cursor: "pointer" }}>
                <Typography sx={{ fontSize: "0.62rem", fontWeight: 700 }}>{leave.type}</Typography>
                <Typography sx={{ mt: 0.3, fontSize: "0.57rem", color: "#78837b" }}>{leave.status} · {leave.days} {leave.days === 1 ? "day" : "days"}</Typography>
              </Box>
            )) : <Typography sx={{ mt: 1, fontSize: "0.6rem", color: "#89948c" }}>No leave scheduled for this day.</Typography>}
          </Box>
        </Box>
      </Panel>

      {/* ── Requests table ────────────────────────────── */}
      <Panel
        title="Leave requests"
        subtitle="Review the status of your time-off plans"
        action={
          <TextField
            select
            size="small"
            value={filter}
            onChange={(e) => setFilter(e.target.value)}
            sx={{
              minWidth: 130,
              "& .MuiOutlinedInput-root": {
                fontSize: "0.65rem",
                borderRadius: 1,
                "& fieldset": { borderColor: "#e5eae5" },
              },
              "& .MuiInputBase-input": { py: 0.8, px: 1 },
            }}
          >
            {["All requests", "Pending", "Approved", "Cancelled"].map((o) => (
              <MenuItem key={o} value={o} sx={{ fontSize: "0.65rem" }}>
                {o}
              </MenuItem>
            ))}
          </TextField>
        }
      >
        <TableContainer sx={{ overflowX: "auto" }}>
          <Table sx={{ minWidth: 720 }}>
            <TableHead>
              <TableRow>
                <TableCell>TYPE</TableCell>
                <TableCell>DATES</TableCell>
                <TableCell>DAYS</TableCell>
                <TableCell>STATUS</TableCell>
                <TableCell>REQUESTED</TableCell>
                <TableCell />
              </TableRow>
            </TableHead>
            <TableBody>
              {filtered.map((leave) => (
                <TableRow
                  key={leave.id}
                  sx={{ "&:hover": { background: "#fcfdfb" } }}
                >
                  <TableCell>
                    <Typography
                      component="button"
                      onClick={() => onAction("leave-detail", leave)}
                      sx={{ p: 0, border: 0, background: "transparent", textAlign: "left", cursor: "pointer", fontSize: "0.65rem", fontWeight: 600, color: "#354138", "&:hover": { color: "primary.main", textDecoration: "underline" } }}
                    >
                      {leave.type}
                    </Typography>
                    <Typography sx={{ fontSize: "0.6rem", color: "#8d978f", mt: 0.4 }}>
                      {leave.id}
                    </Typography>
                  </TableCell>
                  <TableCell>
                    {leave.start}
                    {leave.start !== leave.end && ` – ${leave.end}`}
                  </TableCell>
                  <TableCell>
                    {leave.days} {leave.days === 1 ? "day" : "days"}
                  </TableCell>
                  <TableCell>
                    <Badge
                      tone={
                        leave.status === "Approved"
                          ? "green"
                          : leave.status === "Pending"
                          ? "orange"
                          : "neutral"
                      }
                    >
                      {leave.status}
                    </Badge>
                  </TableCell>
                  <TableCell sx={{ color: "#78837b" }}>{leave.requested}</TableCell>
                  <TableCell>
                    {leave.status === "Pending" && (
                      <Box
                        component="button"
                        onClick={() => onCancel(leave)}
                        sx={{
                          px: 0.9,
                          py: 0.4,
                          border: "1px solid #e6eae6",
                          borderRadius: 0.6,
                          background: "#fff",
                          color: "#6f7b72",
                          fontSize: "0.6rem",
                          cursor: "pointer",
                          "&:hover": { borderColor: "#e7c8b9", color: "#aa694a" },
                        }}
                      >
                        Cancel
                      </Box>
                    )}
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>

          {filtered.length === 0 && (
            <Box
              sx={{
                py: 3.5,
                px: 2,
                textAlign: "center",
                color: "#849087",
                fontSize: "0.65rem",
              }}
            >
              No requests in this view.
            </Box>
          )}
        </TableContainer>
      </Panel>

      {/* ── Notice ────────────────────────────────────── */}
      <Stack
        direction="row"
        alignItems="center"
        spacing={1.1}
        sx={{
          mt: 1.6,
          px: 1.6,
          py: 1.4,
          border: "1px solid #e8ece7",
          borderRadius: 1,
          background: "#fbfcfa",
          color: "#7b867e",
          fontSize: "0.6rem",
        }}
      >
        <Box
          sx={{
            width: 17,
            height: 17,
            border: "1px solid #ccd8cc",
            borderRadius: "50%",
            color: "#6a856e",
            fontFamily: "Georgia, serif",
            fontSize: "0.65rem",
            fontWeight: 600,
            display: "grid",
            placeItems: "center",
            flexShrink: 0,
          }}
        >
          i
        </Box>
        <Typography sx={{ fontSize: "0.6rem", color: "#7b867e" }}>
          <Box component="strong" sx={{ color: "#4b574e" }}>
            Need to change an approved request?
          </Box>{" "}
          Contact the People team at least two working days before your leave.
        </Typography>
      </Stack>
    </>
  );
}
