import React, { useEffect } from "react";
import { Button, ModalFrame } from "./PortalUI.jsx";
import { theme } from "../theme.js";

const configs = {
  employee: { title: "Add a teammate", description: "Create a people directory entry.", submit: "Add teammate", fields: [{ name: "name", label: "Full name", required: true }, { name: "email", label: "Work email", type: "email", required: true }, { name: "department", label: "Department", type: "select", options: ["Engineering", "People", "Finance", "Operations", "Design", "Marketing"] }, { name: "role", label: "Job title", required: true }] },
  leave: { title: "Request time off", description: "Your manager will be notified when you submit.", submit: "Send request", fields: [{ name: "type", label: "Leave type", type: "select", options: ["Casual leave", "Sick leave", "Annual leave", "Unpaid leave"] }, { name: "start", label: "Start date", type: "date", required: true }, { name: "end", label: "End date", type: "date", required: true }, { name: "note", label: "Note for your manager", type: "textarea" }] },
  ticket: { title: "Contact HR support", description: "Tell the People team what you need help with.", submit: "Create ticket", fields: [{ name: "subject", label: "What do you need help with?", required: true }, { name: "category", label: "Category", type: "select", options: ["Payroll", "Time off", "Personal details", "Benefits", "Other"] }, { name: "description", label: "Details", type: "textarea", required: true }] },
  role: { title: "Open a new role", description: "Add a role to the hiring pipeline.", submit: "Create role", fields: [{ name: "title", label: "Role title", required: true }, { name: "department", label: "Department", type: "select", options: ["Engineering", "People", "Finance", "Operations", "Design", "Marketing"] }, { name: "location", label: "Location", required: true }] },
  goal: { title: "Add a goal", description: "Keep a clear outcome and a realistic target date.", submit: "Add goal", fields: [{ name: "title", label: "Goal", required: true }, { name: "area", label: "Focus area", type: "select", options: ["Delivery", "Quality", "Collaboration", "Learning"] }, { name: "due", label: "Target date", type: "date", required: true }] },
};

export default function PortalDialog({ dialog, onClose, onSubmit }) {
  useEffect(() => {
    function onKey(event) { if (event.key === "Escape") onClose(); }
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [onClose]);

  if (!dialog) return null;
  if (dialog.type === "profile" || dialog.type === "person") {
    const person = dialog.data || { ...theme.currentUser, id: theme.currentUser.employeeId, status: "Active" };
    const initials = person.name.split(/\s+/).slice(0, 2).map((part) => part[0]).join("").toUpperCase();
    return <ModalFrame title={dialog.type === "profile" ? "Your profile" : person.name} description="People directory details." onClose={onClose} footer={<Button variant="secondary" onClick={onClose}>Close</Button>}><div className="profile-card"><span className="profile-avatar">{initials}</span><div><strong>{person.name}</strong><small>{person.role}</small></div></div><div className="profile-details"><span>Work email</span><strong>{person.email}</strong><span>Employee ID</span><strong>{person.id}</strong><span>Department</span><strong>{person.department}</strong><span>Status</span><strong>{person.status || "Active"}</strong></div><p className="demo-note">Profile information is sample data for this local demo.</p></ModalFrame>;
  }

  const config = configs[dialog.type];
  if (!config) return null;
  function submit(event) { event.preventDefault(); onSubmit(dialog.type, Object.fromEntries(new FormData(event.currentTarget).entries())); }
  return <ModalFrame title={config.title} description={config.description} onClose={onClose}><form className="action-form" onSubmit={submit}>{config.fields.map((field) => <label className="field" key={field.name}><span>{field.label}{field.required && <i> *</i>}</span>{field.type === "select" ? <select name={field.name} defaultValue={field.options[0]}>{field.options.map((option) => <option key={option}>{option}</option>)}</select> : field.type === "textarea" ? <textarea name={field.name} required={field.required} rows="3" /> : <input name={field.name} type={field.type || "text"} required={field.required} />}</label>)}<div className="form-actions"><Button type="button" variant="secondary" onClick={onClose}>Cancel</Button><Button type="submit">{config.submit}</Button></div></form></ModalFrame>;
}
</file>

<file path="src/components/PortalShell.jsx">
import React, { useState } from "react";
import { Bell, CalendarCheck2, ChartNoAxesColumnIncreasing, Clock3, Files, LayoutDashboard, LifeBuoy, Menu, Search, UserRoundPlus, UsersRound, WalletCards, X } from "lucide-react";
import { navigation, notifications } from "../data/peopleHubData.js";
import { theme } from "../theme.js";
import { Avatar, IconButton } from "./PortalUI.jsx";

const iconMap = { LayoutDashboard, UsersRound, Clock3, CalendarCheck2, WalletCards, ChartNoAxesColumnIncreasing, UserRoundPlus, Files, LifeBuoy };
const iconNames = { timeoff: "CalendarCheck2" };

export default function PortalShell({ page, onNavigate, onSearch, onProfile, children }) {
  const [mobileOpen, setMobileOpen] = useState(false);
  const [search, setSearch] = useState("");
  const [notificationsOpen, setNotificationsOpen] = useState(false);
  const groups = ["Workspace", "Company"];

  function submitSearch(event) {
    event.preventDefault();
    onSearch(search.trim());
    setMobileOpen(false);
  }

  return <div className="app-shell">
    {mobileOpen && <button className="mobile-scrim" aria-label="Close navigation" onClick={() => setMobileOpen(false)} />}
    <aside className={`sidebar ${mobileOpen ? "sidebar-open" : ""}`}>
      <div className="brand-row"><span className="brand-mark">p</span><div className="brand-name">{theme.productName}<small>{theme.workspaceName}</small></div><IconButton label="Close navigation" className="sidebar-close" onClick={() => setMobileOpen(false)}><X size={17} /></IconButton></div>
      {groups.map((group) => <React.Fragment key={group}><div className={`sidebar-caption ${group === "Company" ? "company-caption" : ""}`}>{group === "Workspace" ? "YOUR WORKSPACE" : "PEOPLE & CULTURE"}</div><nav className="side-nav" aria-label={`${group} navigation`}>{navigation.filter((item) => item.group === group).map((item) => { const Icon = iconMap[iconNames[item.id] || item.icon]; return <button key={item.id} className={`nav-item ${page === item.id ? "is-active" : ""}`} onClick={() => { onNavigate(item.id); setMobileOpen(false); }}><Icon size={17} /><span>{item.label}</span>{page === item.id && <i className="nav-marker" />}</button>; })}</nav></React.Fragment>)}
      <div className="sidebar-bottom"><div className="workspace-status"><i className="status-dot" /><div><strong>All systems normal</strong><small>Workspace sync is up to date</small></div></div><button className="sidebar-profile" onClick={onProfile}><Avatar name={theme.currentUser.name} /><span><strong>{theme.currentUser.shortName}</strong><small>{theme.currentUser.role}</small></span><span className="profile-more">•••</span></button></div>
    </aside>
    <main className="main-area"><header className="topbar"><IconButton label="Open navigation" className="mobile-menu" onClick={() => setMobileOpen(true)}><Menu size={20} /></IconButton><div className="breadcrumb"><span>{theme.workspaceName}</span><i>/</i><strong>{navigation.find((item) => item.id === page)?.label || "Overview"}</strong></div><div className="topbar-actions"><form className="global-search" onSubmit={submitSearch}><Search size={16} /><input aria-label="Search people" placeholder="Search people..." value={search} onChange={(event) => setSearch(event.target.value)} /><kbd>Enter</kbd></form><div className="notification-wrap"><IconButton label="Notifications" className={notificationsOpen ? "icon-selected" : ""} onClick={() => setNotificationsOpen((value) => !value)}><Bell size={18} /><i className="notification-dot" /></IconButton>{notificationsOpen && <div className="notification-popover"><div className="popover-heading"><div><strong>Notifications</strong><small>Latest updates for you</small></div><span className="new-count">3 new</span></div>{notifications.map((item) => <div className="notification-item" key={item.title}><span className="notification-icon"><Bell size={15} /></span><div><strong>{item.title}</strong><small>{item.detail}</small></div></div>)}<button className="popover-footer" onClick={() => { setNotificationsOpen(false); onNavigate("timeoff"); }}>Open my updates</button></div>}</div><span className="topbar-divider" /><button className="topbar-user" onClick={onProfile}><Avatar name={theme.currentUser.name} /><span className="topbar-user-name">{theme.currentUser.shortName}</span></button></div></header><div className="page-content">{children}<footer className="page-footer"><span>PeopleHub workspace</span><span>Demo data · Changes are saved in this browser</span></footer></div></main>
  </div>;
}
</file>

<file path="src/components/PortalUI.jsx">
import React from "react";
import { ArrowUpRight, Check, ChevronRight, CircleHelp, X } from "lucide-react";

export function Button({ children, variant = "primary", icon: Icon, className = "", ...props }) {
  return <button className={`button button-${variant} ${className}`} {...props}>{Icon && <Icon size={16} />}{children}</button>;
}

export function IconButton({ children, label, ...props }) {
  return <button className="icon-button" aria-label={label} title={label} {...props}>{children}</button>;
}

export function PageHeader({ eyebrow, title, description, action }) {
  return <div className="page-header"><div>{eyebrow && <p className="eyebrow">{eyebrow}</p>}<h1>{title}</h1>{description && <p className="page-description">{description}</p>}</div>{action && <div className="page-header-action">{action}</div>}</div>;
}

export function Panel({ title, subtitle, action, className = "", children }) {
  return <section className={`panel ${className}`}>{(title || action) && <div className="panel-header"><div>{title && <h2>{title}</h2>}{subtitle && <p>{subtitle}</p>}</div>{action}</div>}{children}</section>;
}

export function StatCard({ label, value, note, icon: Icon, tone = "green" }) {
  return <div className="stat-card"><span className={`stat-icon tone-${tone}`}><Icon size={17} /></span><span className="stat-label">{label}</span><strong>{value}</strong><small>{note}</small></div>;
}

export function Badge({ children, tone = "neutral" }) {
  return <span className={`badge badge-${tone}`}><i />{children}</span>;
}

export function Avatar({ name, size = "normal" }) {
  const initials = name.split(/\s+/).slice(0, 2).map((part) => part[0]).join("").toUpperCase();
  return <span className={`avatar avatar-${size}`} title={name}>{initials}</span>;
}

export function ChevronAction({ children, onClick }) {
  return <button className="subtle-action" onClick={onClick}>{children}<ChevronRight size={15} /></button>;
}

export function EmptyState({ title, description, action }) {
  return <div className="empty-state"><CircleHelp size={22} /><strong>{title}</strong><p>{description}</p>{action}</div>;
}

export function ModalFrame({ title, description, onClose, children, footer }) {
  return <div className="modal-backdrop" onMouseDown={(event) => event.target === event.currentTarget && onClose()}><section className="modal" role="dialog" aria-modal="true" aria-labelledby="dialog-title"><header className="modal-header"><div><h2 id="dialog-title">{title}</h2>{description && <p>{description}</p>}</div><button className="icon-button" aria-label="Close dialog" onClick={onClose}><X size={18} /></button></header><div className="modal-content">{children}</div>{footer && <footer className="modal-footer">{footer}</footer>}</section></div>;
}

export function LinkButton({ children, onClick }) {
  return <button className="link-button" onClick={onClick}>{children}<ArrowUpRight size={14} /></button>;
}

export function SuccessMark() {
  return <span className="success-mark"><Check size={13} /></span>;
}
</file>

