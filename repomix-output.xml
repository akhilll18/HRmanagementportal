                  fontWeight: 700,
                  fontSize: "0.95rem",
                  background:
                    "linear-gradient(112deg, #315f49 0%, #27614e 100%)",
                  boxShadow: "0 6px 20px rgba(36,77,61,0.18)",
                  "&:hover": {
                    background:
                      "linear-gradient(112deg, #234d3d 0%, #1e493a 100%)",
                    boxShadow: "0 8px 24px rgba(36,77,61,0.22)",
                  },
                  "&:disabled": { opacity: 0.7 },
                }}
              >
                {loading ? "Signing In…" : "Sign In"}
              </Button>
            </form>

            <Typography
              sx={{
                textAlign: "center",
                fontSize: "0.8rem",
                color: "#8a8a8a",
                mt: 3,
              }}
            >
              Having trouble signing in?{" "}
              <Link
                href="#"
                underline="hover"
                sx={{ fontWeight: 600, color: "#27614e" }}
              >
                Contact support
              </Link>
            </Typography>

            <Typography
              sx={{
                textAlign: "center",
                fontSize: "0.7rem",
                color: "#b0b0b0",
                mt: 2,
              }}
            >
              Demo credentials: akhilreddy@onaspeoplehub.com / ashok2909
            </Typography>
          </Box>
        </Box>
      </Card>
    </Box>
  );
}
