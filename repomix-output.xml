          </ListItemButton>
        )}
      </Box>
    </Box>
  );

  return (
    <Box sx={{ display: "flex", minHeight: "100vh" }}>
      <Box component="nav" sx={{ width: { md: collapsed ? 72 : DRAWER_WIDTH }, flexShrink: { md: 0 }, transition: "width .18s ease" }}>
        {isMobile ? (
          <Drawer
            open={mobileOpen}
