  Popover,
  Divider,
  Stack,
  useMediaQuery,
  useTheme,
} from "@mui/material";
import {
  Notifications as Bell,
  EventAvailable as CalendarCheck2,
  AccessTime as Clock3,
  Folder as Files,
  Dashboard as LayoutDashboard,
  Support as LifeBuoy,
  Logout as LogOut,
  Menu,
  Search,
  Groups as UsersRound,
