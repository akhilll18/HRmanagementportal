                    fontSize: "0.85rem",
                    color: "#355b43",
                  }}
                >
                  Organization Account Sign In
                </Typography>

                <Typography
                  sx={{
                    fontSize: "0.75rem",
                    color: "#718276",
                    mt: 0.3,
                  }}
                >
                  Enter credentials provisioned by Master Admin
