import React, { useMemo, useState } from "react";
import { ArrowDownToLine, ArrowUpRight, FileText, Plus, Search, Sparkles, Target, UsersRound } from "lucide-react";
import { documents as seedDocuments } from "../data/peopleHubData.js";
import { Badge, Button, EmptyState, PageHeader, Panel, StatCard } from "../components/PortalUI.jsx";

export function GrowthPage({ goals, onAction }) {
  const average = goals.length ? Math.round(goals.reduce((sum, goal) => sum + Number(goal.progress || 0), 0) / goals.length) : 0;
  return <><PageHeader eyebrow="LEARNING & DEVELOPMENT" title="Growth" description="Make progress visible. Keep the next step within reach." action={<Button icon={Plus} onClick={() => onAction("goal")}>Add a goal</Button>} /><div className="growth-banner"><span className="growth-mark"><Sparkles size={19} /></span><div><strong>Your next check-in is a chance to reflect.</strong><p>Bring your goals, learnings and questions to your next 1:1.</p></div><span className="growth-date">MID-YEAR · 2026</span></div><div className="stats-grid three-stats"><StatCard label="Goal progress" value={`${average}%`} note="Average across your goals" icon={Target} tone="green" /><StatCard label="Active goals" value={goals.length} note="In your current cycle" icon={Sparkles} tone="orange" /><StatCard label="Next check-in" value="Oct 30" note="With your manager" icon={UsersRound} tone="blue" /></div><Panel title="Your goals" subtitle="Current cycle · June–December 2026">{goals.length ? <div className="goal-list">{goals.map((goal, index) => <div className="goal-row" key={`${goal.title}-${index}`}><span className={`goal-index goal-index-${index % 3}`}>{String(index + 1).padStart(2, "0")}</span><div className="goal-detail"><div className="goal-title-row"><strong>{goal.title}</strong><Badge>{goal.area}</Badge></div><div className="progress-track"><span style={{ width: `${goal.progress}%` }} /></div><div className="goal-meta"><span>{goal.progress}% complete</span><span>Target · {goal.due}</span></div></div></div>)}</div> : <EmptyState title="No goals yet" description="Add a goal to start tracking your progress." action={<Button icon={Plus} onClick={() => onAction("goal")}>Add a goal</Button>} />}</Panel></>;
}

export function HiringPage({ roles, onAction }) {
  const [stage, setStage] = useState("All stages");
  const filtered = roles.filter((role) => stage === "All stages" || role.stage === stage);
  return <><PageHeader eyebrow="PEOPLE & CULTURE" title="Hiring" description="A snapshot of the roles bringing new people to the team." action={<Button icon={Plus} onClick={() => onAction("role")}>Open a role</Button>} /><div className="stats-grid three-stats"><StatCard label="Open roles" value={roles.length} note="Across the company" icon={UsersRound} tone="green" /><StatCard label="In the pipeline" value={roles.reduce((sum, role) => sum + Number(role.candidates || 0), 0)} note="Candidates under review" icon={Target} tone="blue" /><StatCard label="Interviewing" value={roles.filter((role) => role.stage === "Interviewing").length} note="Roles at interview stage" icon={Sparkles} tone="orange" /></div><Panel title="Open positions" subtitle="Current roles and candidate pipeline" action={<select className="period-select" aria-label="Filter hiring stage" value={stage} onChange={(event) => setStage(event.target.value)}><option>All stages</option><option>Sourcing</option><option>Screening</option><option>Interviewing</option></select>}><div className="table-scroll"><table className="data-table"><thead><tr><th>ROLE</th><th>DEPARTMENT</th><th>LOCATION</th><th>CANDIDATES</th><th>STAGE</th></tr></thead><tbody>{filtered.map((role, index) => <tr key={`${role.title}-${index}`}><td><span className="role-cell"><i className="role-icon"><UsersRound size={16} /></i><strong>{role.title}</strong></span></td><td>{role.department}</td><td>{role.location}</td><td>{role.candidates}</td><td><Badge tone={role.stage === "Interviewing" ? "blue" : "neutral"}>{role.stage}</Badge></td></tr>)}</tbody></table>{filtered.length === 0 && <div className="table-empty">No roles in this stage.</div>}</div></Panel><p className="privacy-footnote">Candidate totals are sample figures for this local demo.</p></>;
}

function downloadFile(name, content) { const url = URL.createObjectURL(new Blob([content], { type: "text/plain" })); const link = document.createElement("a"); link.href = url; link.download = name; link.click(); URL.revokeObjectURL(url); }

export function DocumentsPage() {
  const [category, setCategory] = useState("All documents"); const [query, setQuery] = useState("");
  const categories = ["All documents", ...new Set(seedDocuments.map((document) => document.category))];
  const filtered = useMemo(() => seedDocuments.filter((document) => (category === "All documents" || document.category === category) && `${document.name} ${document.category}`.toLowerCase().includes(query.toLowerCase())), [category, query]);
  return <><PageHeader eyebrow="YOUR REFERENCE LIBRARY" title="Documents" description="Company policies, benefits and useful forms in one place." /><div className="document-tools"><label className="field-search"><Search size={16} /><input aria-label="Search documents" placeholder="Find a document..." value={query} onChange={(event) => setQuery(event.target.value)} /></label><div className="filter-tabs" role="tablist" aria-label="Document category">{categories.map((item) => <button key={item} role="tab" aria-selected={category === item} className={category === item ? "filter-tab active-tab" : "filter-tab"} onClick={() => setCategory(item)}>{item}</button>)}</div></div><div className="documents-grid">{filtered.map((document, index) => <article className="document-card" key={document.name}><span className={`document-icon document-color-${index % 4}`}><FileText size={19} /></span><Badge>{document.category}</Badge><h2>{document.name}</h2><p>{document.description}</p><div className="document-card-footer"><span>{document.updated}</span><button onClick={() => downloadFile(`${document.name.toLowerCase().replaceAll(" ", "-")}.txt`, `${document.name}\n\n${document.description}\n\nSample PeopleHub document.`)}><ArrowDownToLine size={15} /> Download</button></div></article>)}</div>{filtered.length === 0 && <EmptyState title="No documents found" description="Try another search or category." />}</>;
}

export function SupportPage({ tickets, onAction }) {
  const [query, setQuery] = useState(""); const filtered = tickets.filter((ticket) => `${ticket.id} ${ticket.subject} ${ticket.category}`.toLowerCase().includes(query.toLowerCase()));
