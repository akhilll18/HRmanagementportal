    <div className="section-intro"><div><p className="eyebrow">MONDAY SNAPSHOT</p><h2>Your overview</h2></div><span className="updated-label"><i className="status-dot" /> Updated just now</span></div>
    <div className="stats-grid"><StatCard label="Team members" value={employeeCount} note="Across 5 departments" icon={UsersRound} tone="green" /><StatCard label="Request leave " value="8 days" note="Available balance" icon={CalendarDays} tone="orange" /><StatCard label="Next payday" value="Oct 30" note="October payroll" icon={WalletCards} tone="blue" /><StatCard label="Open requests" value={String(pendingLeaves).padStart(2, "0")} note="Leave awaiting review" icon={Clock3} tone="rose" /></div>
    <div className="dashboard-grid dashboard-row-one"><Panel title="Your week" subtitle="Hours worked · Oct 05–09" action={<span className="period-label">This week</span>}><div className="chart-summary"><strong>41.1 <small>hrs</small></strong><span><ArrowUpRight size={14} /> 3.4% <small>vs last week</small></span></div><div className="week-chart">{attendanceDays.map((day, index) => <div className="chart-column" key={day.day}><div className="chart-value" style={{ height: `${Math.round(day.hours / 9 * 100)}%`, animationDelay: `${index * 60}ms` }}><span>{day.label}</span></div><small>{day.day}</small></div>)}</div></Panel>
      <Panel title="Coming up" subtitle="A few things on your radar" action={<ChevronAction onClick={() => onNavigate("growth")}>View goals</ChevronAction>}><div className="task-list">{tasks.map((task) => <button className="task-row" key={task.title} onClick={() => onNavigate(task.route)}><span className="task-icon"><task.icon size={16} /></span><span className="task-main"><strong>{task.title}</strong><small>{task.detail}</small></span><span className="task-time">{task.status}</span><ArrowUpRight className="task-arrow" size={15} /></button>)}</div></Panel></div>
