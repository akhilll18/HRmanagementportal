:24px;border-left:1px solid var(--line)}.topbar-user{display:flex;align-items:center;gap:8px;padding:0;border:0;background:transparent;cursor:pointer}.topbar-user-name{font-size:11px;font-weight:600}.avatar{display:inline-grid;width:31px;height:31px;flex:0 0 auto;place-items:center;border:1px solid #dce9df;border-radius:50%;background:#eaf2ec;color:#3c7155;font-size:10px;font-weight:700}.avatar-large{width:63px;height:63px;border:2px solid rgb(255 255 255 / 74%);background:#d6e7da;color:#315f49;font-size:17px}.notification-wrap{position:relative}.notification-popover{position:absolute;top:45px;right:-45px;z-index:40;width:330px;overflow:hidden;border:1px solid var(--line);border-radius:9px;background:#fff;box-shadow:0 14px 42px rgb(25 43 31 / 14%);animation:pop-in .16s ease-out}.popover-heading{display:flex;align-items:center;justify-content:space-between;padding:15px 16px 12px;border-bottom:1px solid #edf0ec}.popover-heading strong,.popover-heading small{display:block}.popover-heading strong{font-size:13px}.popover-heading small{margin-top:3px;color:var(--muted);font-size:10px}.new-count{padding:4px 7px;border-radius:4px;background:#edf4ee;color:var(--green);font-size:9px;font-weight:700}.notification-item{display:flex;align-items:flex-start;gap:10px;padding:12px 15px;border-bottom:1px solid #f0f2ef}.notification-icon{display:grid;width:27px;height:27px;flex:0 0 auto;place-items:center;border-radius:6px;background:#edf3ee;color:var(--green)}.notification-item strong,.notification-item small{display:block}.notification-item strong{font-size:10px;font-weight:600}.notification-item small{margin-top:4px;color:var(--muted);font-size:9px}.popover-footer{width:100%;padding:11px;border:0;background:#fbfcfa;color:var(--green);font-size:10px;font-weight:700;cursor:pointer}.page-content{width:min(100%,1370px);min-height:calc(100vh - 62px);margin:0 auto;padding:29px 34px 12px;background-image:radial-gradient(#dfe5df .55px,transparent .55px);background-size:19px 19px}.page-cont