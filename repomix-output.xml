              </Typography>
              <Typography sx={{ color: "#c8cec9" }}>/</Typography>
              <Typography sx={{ fontSize: "0.65rem", fontWeight: 600, color: "#3d4941" }}>
                {navigation.find((i) => i.id === page)?.label || "Overview"}
              </Typography>
            </Stack>

            <Stack direction="row" alignItems="center" spacing={1.5}>
              <Box
                component="form"
                onSubmit={submitSearch}
                sx={{
                  display: { xs: "none", sm: "flex" },
                  width: 230,
                  height: 34,
                  alignItems: "center",
                  gap: 1,
                  px: 1.2,
                  border: "1px solid #e8ece8",
                  borderRadius: 1,
                  background: "#fafbf9",
                  color: "#8a948d",
                  "&:focus-within": {
                    borderColor: "#9eb9a7",
                    boxShadow: "0 0 0 3px rgba(78,129,96,0.09)",
                  },
                }}
              >
                <Search sx={{ fontSize: 16 }} />
                <InputBase
                  placeholder="Search people..."
                  value={search}
                  onChange={(e) => setSearch(e.target.value)}
                  sx={{ fontSize: "0.65rem", flex: 1 }}
                />
                <Typography
                  sx={{
                    fontSize: "0.55rem",
                    border: "1px solid #e4e8e4",
                    borderRadius: 0.5,
                    px: 0.6,
                    py: 0.2,
                    color: "#9aa39c",
                  }}
                >
                  Enter
                </Typography>
              </Box>

              <MuiIconButton
                size="small"
                onClick={(e) => setNotifAnchor(e.currentTarget)}
                sx={{ color: "#66716a", "&:hover": { background: "#f1f4f0" } }}
              >
                <MuiBadge color="secondary" variant="dot" overlap="circular">
                  <Bell sx={{ fontSize: 18 }} />
                </MuiBadge>
              </MuiIconButton>

              <Popover
                open={Boolean(notifAnchor)}
                anchorEl={notifAnchor}
                onClose={() => setNotifAnchor(null)}
