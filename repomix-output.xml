                PaperProps={{ sx: { width: 330, mt: 1, borderRadius: 1.5 } }}
              >
                <Box
                  sx={{
                    p: 2,
                    pb: 1.5,
                    borderBottom: "1px solid #edf0ec",
                    display: "flex",
                    justifyContent: "space-between",
                    alignItems: "center",
                  }}
                >
                  <Box>
                    <Typography sx={{ fontSize: "0.8rem", fontWeight: 700 }}>
                      Notifications
                    </Typography>
                    <Typography sx={{ fontSize: "0.6rem", color: "#78827b", mt: 0.3 }}>
                      Latest updates for you
                    </Typography>
                  </Box>
                  <Box
                    sx={{
                      px: 1,
                      py: 0.5,
                      borderRadius: 0.5,
                      background: "#edf4ee",
                      color: "primary.main",
                      fontSize: "0.55rem",
                      fontWeight: 700,
                    }}
                  >
                    3 new
                  </Box>
                </Box>

                {notifications.map((item) => (
                  <Box
                    key={item.title}
                    sx={{
                      display: "flex",
                      gap: 1.2,
                      p: "12px 15px",
                      borderBottom: "1px solid #f0f2ef",
                    }}
                  >
                    <Box
                      sx={{
                        width: 27,
                        height: 27,
                        borderRadius: 1,
                        background: "#edf3ee",
                        color: "primary.main",
                        display: "grid",
                        placeItems: "center",
                        flexShrink: 0,
                      }}
                    >
                      <Bell sx={{ fontSize: 15 }} />
                    </Box>
                    <Box>
                      <Typography sx={{ fontSize: "0.65rem", fontWeight: 600 }}>
                        {item.title}
                      </Typography>
                      <Typography sx={{ fontSize: "0.6rem", color: "#78827b", mt: 0.4 }}>
                        {item.detail}
                      </Typography>
                    </Box>
                  </Box>
                ))}

                <Box
                  onClick={() => {
                    setNotifAnchor(null);
                    onNavigate("timeoff");
                  }}
                  sx={{
                    p: 1.4,
                    textAlign: "center",
                    background: "#fbfcfa",
                    color: "primary.main",
                    fontSize: "0.65rem",
                    fontWeight: 700,
                    cursor: "pointer",
                  }}
                >
                  Open my updates
                </Box>
              </Popover>

              <Divider orientation="vertical" flexItem sx={{ display: { xs: "none", md: "block" } }} />

              <Stack
                direction="row"
                alignItems="center"
                spacing={1}
                onClick={onProfile}
                sx={{ cursor: "pointer" }}
              >
                <Avatar name={theme.currentUser.name} />
