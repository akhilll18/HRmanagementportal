            {theme.productName}
          </Typography>
          <Typography sx={{ fontSize: "0.6rem", color: "#78827b", mt: 0.5 }}>
            {theme.workspaceName}
          </Typography>
        </Box>}
        {isMobile && (
          <MuiIconButton
            size="small"
            onClick={() => setMobileOpen(false)}
            sx={{ ml: "auto" }}
          >
            <X sx={{ fontSize: 17 }} />
          </MuiIconButton>
        )}
      </Stack>

      {groups.map((group) => (
        <Box key={group} sx={{ mb: 2 }}>
          {!collapsed && <Typography
            sx={{
              px: 1.2,
              pb: 1,
              fontSize: "0.55rem",
              fontWeight: 700,
              letterSpacing: "1.1px",
              color: "#a1aaa3",
            }}
          >
            {group === "Workspace" ? "YOUR WORKSPACE" : "PEOPLE & CULTURE"}
          </Typography>}
          <List disablePadding>
            {navigation
              .filter((item) => item.group === group)
              .map((item) => {
                const Icon = iconMap[iconNames[item.id] || item.icon];
                const active = page === item.id;
                return (
                  <ListItemButton
                    key={item.id}
                    title={collapsed ? item.label : undefined}
                    onClick={() => {
                      onNavigate(item.id);
                      setMobileOpen(false);
                    }}
                    sx={{
                      position: "relative",
                      minHeight: 37,
                      px: 1.2,
                      borderRadius: 1,
                      color: active ? "primary.main" : "#66716a",
                      background: active ? "#eaf2ed" : "transparent",
                      "&:hover": {
                        background: active ? "#eaf2ed" : "#f0f4f0",
                        color: active ? "primary.main" : "#202922",
                      },
                      mb: 0.4,
                    }}
                  >
                    {active && (
                      <Box
                        sx={{
                          position: "absolute",
                          left: 0,
                          top: 10,
                          bottom: 10,
                          width: 2,
                          borderRadius: 1,
                          background: "primary.main",
                        }}
                      />
                    )}
                    <ListItemIcon sx={{ minWidth: 30, color: "inherit" }}>
                      <Icon sx={{ fontSize: 17 }} />
                    </ListItemIcon>
                    <ListItemText
                      sx={{ display: collapsed ? "none" : "block" }}
