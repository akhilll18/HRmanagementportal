import React, { useMemo, useState } from "react";
import { ArrowDownToLine, CalendarDays, Check, Clock3, Download, Plus, WalletCards } from "lucide-react";
import { attendanceDays, payslips } from "../data/peopleHubData.js";
import { Badge, Button, PageHeader, Panel, StatCard } from "../components/PortalUI.jsx";

export function AttendancePage({ checkedIn, onToggle }) {
  const [range, setRange] = useState("This week");
  const days = range === "This week" ? attendanceDays : attendanceDays.map((day, index) => ({ ...day, date: ["Sep 28", "Sep 29", "Sep 30", "Oct 01", "Oct 02"][index], hours: [7.8, 8.4, 8.1, 7.5, 8.7][index], label: ["7h 48m", "8h 24m", "8h 06m", "7h 30m", "8h 42m"][index] }));
  return <><PageHeader eyebrow="TIME & ATTENDANCE" title="Attendance" description="Your hours, your rhythm. Keep track of your work week." action={<Button icon={checkedIn ? Check : Clock3} onClick={onToggle}>{checkedIn ? "Clock out" : "Clock in"}</Button>} />
    <div className="stats-grid three-stats"><StatCard label="Today's status" value={checkedIn ? "Working" : "Not started"} note={checkedIn ? "Clocked in at 9:12 AM" : "Your workday has not started"} icon={Clock3} tone="green" /><StatCard label="Hours this week" value="41h 06m" note="Target is 40 hours" icon={CalendarDays} tone="blue" /><StatCard label="On-time days" value="18 / 20" note="This month" icon={Check} tone="orange" /></div>
    <Panel className="attendance-panel" title="Hours worked" subtitle={`${range} · ${range === "This week" ? "Oct 05–09" : "Sep 28–Oct 02"}`} action={<select className="period-select" aria-label="Choose attendance period" value={range} onChange={(event) => setRange(event.target.value)}><option>This week</option><option>Last week</option></select>}><div className="attendance-bars">{days.map((day, index) => <div className="attendance-day" key={day.day}><div className="attendance-bar-track"><div className="attendance-bar-fill" style={{ height: `${Math.round(day.hours / 9 * 100)}%`, animationDelay: `${index * 55}ms` }} /><span>{day.label}</span></div><strong>{day.day}</strong><small>{day.date}</small></div>)}</div><div className="attendance-foot"><span><i className="legend-dot" />Hours worked</span><span>Standard day <strong>8h</strong></span></div></Panel>
    <div className="dashboard-grid work-detail-grid"><Panel title="Today" subtitle="Monday, October 12"><div className="timeline"><span className="timeline-mark"><i /></span><div className="timeline-copy"><strong>{checkedIn ? "Clocked in" : "Ready to start"}</strong><small>{checkedIn ? "09:12 AM · Office" : "No check-in recorded yet"}</small></div><span className="timeline-time">{checkedIn ? "09:12" : "--:--"}</span></div><div className="timeline timeline-muted"><span className="timeline-mark"><i /></span><div className="timeline-copy"><strong>Clock out</strong><small>End of your work day</small></div><span className="timeline-time">--:--</span></div></Panel><Panel title="Attendance policy" subtitle="A quick reminder"><p className="policy-copy">Our standard working day is 8 hours, with flexible start times between 8:00 and 10:00 AM. Need to correct a time entry? Reach out to HR support.</p><button className="text-link" onClick={() => window.dispatchEvent(new CustomEvent("open-support"))}>Ask HR support <span>↗</span></button></Panel></div>
  </>;
}

export function TimeOffPage({ leaves, onAction, onCancel }) {
  const [filter, setFilter] = useState("All requests");
  const filtered = leaves.filter((leave) => filter === "All requests" || leave.status === filter);
  return <><PageHeader eyebrow="TIME AWAY" title="Time off" description="Plan a break and keep your team in the loop." action={<Button icon={Plus} onClick={() => onAction("leave")}>Request time off</Button>} />
    <div className="leave-balance-row"><div className="leave-balance-lead"><span className="balance-icon"><CalendarDays size={19} /></span><div><span>YOUR BALANCE</span><strong>8 <small>days available</small></strong><p>Resets on January 1, 2027</p></div></div><div className="balance-types"><div><i className="balance-type-dot balance-dot-green" /><span>Casual leave</span><strong>5 days</strong></div><div><i className="balance-type-dot balance-dot-orange" /><span>Sick leave</span><strong>3 days</strong></div></div></div>
    <Panel title="Your requests" subtitle="Review the status of your time-off plans" action={<select className="period-select" aria-label="Filter leave requests" value={filter} onChange={(event) => setFilter(event.target.value)}><option>All requests</option><option>Pending</option><option>Approved</option><option>Cancelled</option></select>}><div className="table-scroll"><table className="data-table"><thead><tr><th>TYPE</th><th>DATES</th><th>DAYS</th><th>STATUS</th><th>REQUESTED</th><th /></tr></thead><tbody>{filtered.map((leave) => <tr key={leave.id}><td><strong className="table-primary">{leave.type}</strong><small className="table-secondary">{leave.id}</small></td><td>{leave.start}{leave.start !== leave.end && ` – ${leave.end}`}</td><td>{leave.days} {leave.days === 1 ? "day" : "days"}</td><td><Badge tone={leave.status === "Approved" ? "green" : leave.status === "Pending" ? "orange" : "neutral"}>{leave.status}</Badge></td><td className="date-cell">{leave.requested}</td><td>{leave.status === "Pending" && <button className="table-action" onClick={() => onCancel(leave.id)}>Cancel</button>}</td></tr>)}</tbody></table>{filtered.length === 0 && <div className="table-empty">No requests in this view.</div>}</div></Panel>
    <div className="inline-notice"><span className="notice-icon">i</span><span><strong>Need to change an approved request?</strong> Contact the People team at least two working days before your leave.</span></div>
  </>;
}

function money(value) { return new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR", maximumFractionDigits: 0 }).format(value); }

export function PayPage() {
  const [year, setYear] = useState("2026");
  const rows = useMemo(() => payslips.filter((slip) => slip.month.endsWith(year)), [year]);
  function download(selected = rows) { const content = [["Month", "Gross", "Deductions", "Net", "Status"], ...selected.map((row) => [row.month, row.gross, row.deductions, row.net, row.status])].map((row) => row.join(",")).join("\n"); const url = URL.createObjectURL(new Blob([content], { type: "text/csv" })); const link = document.createElement("a"); link.href = url; link.download = selected.length === 1 ? `payslip-${selected[0].month.toLowerCase().replaceAll(" ", "-")}.csv` : `payslips-${year}.csv`; link.click(); URL.revokeObjectURL(url); }
  return <><PageHeader eyebrow="COMPENSATION" title="Pay" description="A clear view of your salary and recent pay statements." action={<Button variant="secondary" icon={ArrowDownToLine} onClick={() => download()}>Download summary</Button>} />
    <div className="pay-hero"><span className="pay-hero-icon"><WalletCards size={20} /></span><div><span>LAST NET PAY · SEPTEMBER 2026</span><strong>{money(52133)}</strong><small>Deposited to your registered bank account on Sep 30</small></div><Badge tone="light-green">Paid</Badge><i className="pay-spark pay-spark-one" /><i className="pay-spark pay-spark-two" /></div>
    <div className="stats-grid three-stats"><StatCard label="Monthly gross" value={money(58333)} note="Base salary and allowances" icon={WalletCards} tone="green" /><StatCard label="Deductions" value={money(6200)} note="Tax and benefits" icon={ArrowDownToLine} tone="orange" /><StatCard label="Next payday" value="Oct 30" note="October 2026 payroll" icon={CalendarDays} tone="blue" /></div>
    <Panel title="Pay history" subtitle="Your recent pay statements" action={<select className="period-select" value={year} aria-label="Filter payroll by year" onChange={(event) => setYear(event.target.value)}><option>2026</option><option>2025</option></select>}><div className="table-scroll"><table className="data-table"><thead><tr><th>PAY PERIOD</th><th>GROSS PAY</th><th>DEDUCTIONS</th><th>NET PAY</th><th>STATUS</th><th>STATEMENT</th></tr></thead><tbody>{rows.map((row) => <tr key={row.month}><td><strong className="table-primary">{row.month}</strong></td><td>{money(row.gross)}</td><td className="muted-amount">− {money(row.deductions)}</td><td><strong className="net-amount">{money(row.net)}</strong></td><td><Badge tone="green">{row.status}</Badge></td><td><button className="download-row" aria-label={`Download ${row.month} statement`} onClick={() => download([row])}><Download size={15} /></button></td></tr>)}</tbody></table>{rows.length === 0 && <div className="table-empty">No statements found for {year}.</div>}</div><div className="table-foot"><span>Amounts shown in Indian rupees</span><button className="text-link" onClick={() => window.dispatchEvent(new CustomEvent("open-support"))}>Questions about your pay? <span>↗</span></button></div></Panel>
  </>;
}
</file>

