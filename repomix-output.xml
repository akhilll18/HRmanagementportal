import React from "react";
import { ArrowDownRight, ArrowUpRight, CalendarDays, Check, Clock3, FileText, Sparkles, UsersRound, WalletCards } from "lucide-react";
import { attendanceDays } from "../data/peopleHubData.js";
import { theme } from "../theme.js";
import { Avatar, Button, ChevronAction, Panel, StatCard } from "../components/PortalUI.jsx";

const tasks = [
  { title: "Complete your profile", detail: "Add an emergency contact", icon: UsersRound, route: "people", status: "5 min" },
  { title: "Review your goals", detail: "Your mid-year check-in is open", icon: Sparkles, route: "growth", status: "Due Oct 30" },
  { title: "Read the updated handbook", detail: "People policies · Updated Sep 12", icon: FileText, route: "documents", status: "New" },
