import React, { useState } from "react";
import { Box, MenuItem, Stack, TextField, Typography } from "@mui/material";
import { Delete, PlayArrow, School, UploadFile } from "@mui/icons-material";
import { Button, PageHeader, Panel } from "../components/PortalUI.jsx";

const categories = ["Getting started", "Tools & systems", "Safety & compliance", "Role training"];

export default function LearningPage({ videos, onUpload, onDelete }) {
  const [title, setTitle] = useState("");
  const [description, setDescription] = useState("");
  const [category, setCategory] = useState(categories[0]);
  const [file, setFile] = useState(null);

  function submitVideo(event) {
    event.preventDefault();
    if (!file) return;
    onUpload(file, { title: title.trim(), description: description.trim(), category });
    setTitle("");
    setDescription("");
    setCategory(categories[0]);
    setFile(null);
    event.currentTarget.reset();
  }

  return (
    <>
      <PageHeader
        eyebrow="EMPLOYEE DEVELOPMENT"
        title="Learning"
        description="Training videos and resources to help you grow in your role."
      />

      <Panel title="Training library" subtitle={`${videos.length} video${videos.length === 1 ? "" : "s"} available`}>
        {videos.length ? (
          <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", md: "repeat(2, minmax(0, 1fr))" }, gap: 1.5, p: 1.8 }}>
            {videos.map((video) => (
              <Box key={video.id} sx={{ overflow: "hidden", border: "1px solid #e7ece7", borderRadius: 1.2, background: "#fff" }}>
                <Box sx={{ aspectRatio: "16 / 9", background: "#18231c" }}>
                  <video src={video.data} controls preload="metadata" aria-label={video.title} style={{ width: "100%", height: "100%" }} />
                </Box>
                <Box sx={{ p: 1.5 }}>
                  <Stack direction="row" alignItems="flex-start" justifyContent="space-between" spacing={1}>
                    <Box sx={{ minWidth: 0 }}>
                      <Typography sx={{ color: "#303b33", fontSize: "0.75rem", fontWeight: 700 }}>{video.title}</Typography>
                      <Typography sx={{ mt: 0.45, color: "#65806b", fontSize: "0.58rem", fontWeight: 600 }}>{video.category} · Added {video.uploaded}</Typography>
                    </Box>
                    <Button variant="secondary" aria-label={`Delete ${video.title}`} onClick={() => onDelete(video.id)} sx={{ minWidth: 34, px: 0.6, color: "#a54e45" }}>
                      <Delete sx={{ fontSize: 17 }} />
                    </Button>
                  </Stack>
                  {video.description && <Typography sx={{ mt: 1, color: "#78837b", fontSize: "0.62rem", lineHeight: 1.6 }}>{video.description}</Typography>}
                </Box>
              </Box>
            ))}
          </Box>
        ) : (
          <Box sx={{ display: "grid", minHeight: 170, placeItems: "center", p: 3, textAlign: "center" }}>
            <Box>
              <PlayArrow sx={{ color: "#81a28a", fontSize: 35 }} />
              <Typography sx={{ mt: 0.8, color: "#465249", fontSize: "0.75rem", fontWeight: 700 }}>Your learning library is ready</Typography>
              <Typography sx={{ mt: 0.5, color: "#89948c", fontSize: "0.62rem" }}>New training videos uploaded by your admin will appear here.</Typography>
            </Box>
          </Box>
        )}
      </Panel>

      <Panel title="Admin upload" subtitle="Add a training video to the employee library" sx={{ mt: 1.8 }}>
        <Box component="form" onSubmit={submitVideo} sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", md: "1fr 1fr" }, gap: 1.4, p: 1.8 }}>
          <TextField
            label="Video title"
            required
            size="small"
            value={title}
            onChange={(event) => setTitle(event.target.value)}
            sx={{ "& .MuiInputBase-root, & .MuiInputLabel-root": { fontSize: "0.68rem" } }}
          />
          <TextField
            select
            label="Training category"
            size="small"
            value={category}
            onChange={(event) => setCategory(event.target.value)}
            sx={{ "& .MuiInputBase-root, & .MuiInputLabel-root": { fontSize: "0.68rem" } }}
          >
            {categories.map((item) => <MenuItem key={item} value={item} sx={{ fontSize: "0.68rem" }}>{item}</MenuItem>)}
          </TextField>
          <TextField
            label="Description"
            multiline
            minRows={2}
            value={description}
            onChange={(event) => setDescription(event.target.value)}
            sx={{ "& .MuiInputBase-root, & .MuiInputLabel-root": { fontSize: "0.68rem" } }}
          />
          <Stack spacing={1} justifyContent="center">
            <Button component="label" variant="secondary" icon={UploadFile} sx={{ justifyContent: "flex-start", width: "fit-content", maxWidth: "100%" }}>
              {file ? file.name : "Choose a video file"}
              <input
                hidden
                type="file"
                accept="video/*"
                onChange={(event) => setFile(event.target.files?.[0] || null)}
              />
            </Button>
            <Typography sx={{ color: "#89948c", fontSize: "0.58rem" }}>MP4, WebM, or another browser-supported video · Up to 2 MB in this local demo.</Typography>
          </Stack>
          <Box sx={{ gridColumn: { md: "1 / -1" } }}>
            <Button type="submit" icon={School} disabled={!file}>Upload training video</Button>
          </Box>
        </Box>
      </Panel>
    </>
  );
}
</file>

