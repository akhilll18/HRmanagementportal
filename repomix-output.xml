  Close as X,
} from "@mui/icons-material";
import { navigation, notifications } from "../data/peopleHubData.js";
import { theme } from "../theme.js";
import { Avatar } from "./PortalUI.jsx";

const iconMap = {
  LayoutDashboard,
  UsersRound,
  Clock3,
  CalendarCheck2,
  WalletCards,
  Files,
  LifeBuoy,
  AccountTree,
  School,
};
const iconNames = { timeoff: "CalendarCheck2" };
const DRAWER_WIDTH = 250;

export default function PortalShell({
  page,
  onNavigate,
  onSearch,
  onProfile,
  onLogout,
  children,
}) {
  const muiTheme = useTheme();
  const isMobile = useMediaQuery(muiTheme.breakpoints.down("md"));
  const [mobileOpen, setMobileOpen] = useState(false);
  const [collapsed, setCollapsed] = useState(false);
  const [search, setSearch] = useState("");
  const [notifAnchor, setNotifAnchor] = useState(null);

  const groups = ["Workspace", "Company"];

  function submitSearch(e) {
    e.preventDefault();
    onSearch(search.trim());
    setMobileOpen(false);
  }

  const drawerContent = (
    <Box
      sx={{
        display: "flex",
        flexDirection: "column",
        height: "100%",
        p: collapsed ? "21px 9px 13px" : "21px 14px 13px",
        background: "#fbfcfa",
      }}
    >
      <Stack direction="row" alignItems="center" spacing={1.2} sx={{ px: 1, pb: 3.5 }}>
        <Box
          sx={{
            width: 34,
            height: 34,
            borderRadius: "10px 10px 10px 3px",
            background: "#27614e",
            color: "#fff",
            display: "grid",
            placeItems: "center",
            fontFamily: "Manrope",
            fontWeight: 800,
            fontSize: "1.4rem",
            pb: 0.5,
          }}
        >
          p
        </Box>
        {!collapsed && <Box>
          <Typography
            sx={{
              fontFamily: "Manrope",
